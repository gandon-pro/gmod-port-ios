 int m_type=kGLMVertexBuffer;GLenum m_buffGLTarget=GL_ARRAY_BUFFER;GLuint m_nHandle=0;
 char m_StaticBuffers[2][32]{};char* m_pStaticBuffer=nullptr;
 char* Attempt(uint offset,uint size){
  Params params{offset,size};Params* pParams=&params;
  char* mapPtr=static_cast<char*>(glMapBufferRange(m_buffGLTarget,offset,size,0)); // Deliberately rejected map.
  @FALLBACK@
  return mapPtr;
 }
};
int main(){
 EGLDisplay d=eglGetPlatformDisplay(0x31DD,EGL_DEFAULT_DISPLAY,nullptr);assert(d!=EGL_NO_DISPLAY&&eglInitialize(d,nullptr,nullptr));assert(eglBindAPI(EGL_OPENGL_ES_API));
 EGLint attrs[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES3_BIT,EGL_NONE};EGLConfig cfg;EGLint n;
 assert(eglChooseConfig(d,attrs,&cfg,1,&n)&&n==1);EGLint sz[]={EGL_WIDTH,1,EGL_HEIGHT,1,EGL_NONE},ca[]={EGL_CONTEXT_CLIENT_VERSION,3,EGL_NONE};
 EGLSurface surf=eglCreatePbufferSurface(d,cfg,sz);EGLContext ctx=eglCreateContext(d,cfg,EGL_NO_CONTEXT,ca);assert(eglMakeCurrent(d,surf,surf,ctx));
 Buffer b;glGenBuffers(1,&b.m_nHandle);glBindBuffer(GL_ARRAY_BUFFER,b.m_nHandle);glBufferData(GL_ARRAY_BUFFER,32,nullptr,GL_STATIC_DRAW);
 char* cpu=b.Attempt(8,16);assert(cpu==b.m_StaticBuffers[0]);
 unsigned input[4]={0x12345678,0xabcdef01,2,3};std::memcpy(cpu,input,16);
 // Same bounded upload used by CGLMBuffer::Unlock's existing staging branch.
 glBufferSubData(GL_ARRAY_BUFFER,8,16,cpu);
 void* read=glMapBufferRange(GL_ARRAY_BUFFER,8,16,GL_MAP_READ_BIT);assert(read&&std::memcmp(read,input,16)==0);assert(glUnmapBuffer(GL_ARRAY_BUFFER));
 assert(!b.Attempt(28,16));
 void* mapped=glMapBufferRange(GL_ARRAY_BUFFER,0,16,GL_MAP_WRITE_BIT);assert(mapped);assert(!b.Attempt(0,16));assert(glUnmapBuffer(GL_ARRAY_BUFFER));
 ops.forcedError=GL_OUT_OF_MEMORY;assert(!b.Attempt(0,16));
 g_bDisableStaticBuffer=true;assert(!b.Attempt(0,16));g_bDisableStaticBuffer=false;
 GLuint other;glGenBuffers(1,&other);glBindBuffer(GL_ARRAY_BUFFER,other);glBufferData(GL_ARRAY_BUFFER,32,nullptr,GL_STATIC_DRAW);assert(!b.Attempt(0,16));
 assert(glGetError()==GL_NO_ERROR);glDeleteBuffers(1,&other);glDeleteBuffers(1,&b.m_nHandle);
 eglMakeCurrent(d,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT);eglDestroyContext(d,ctx);eglDestroySurface(d,surf);eglTerminate(d);
 std::puts("Source buffer fallback: failed map recovered, uploaded bytes verified; bounds, mapped, OOM, disabled and wrong binding rejected");
