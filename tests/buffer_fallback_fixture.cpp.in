 GLenum glGetError(){GLenum e=::glGetError();if(forcedError){e=forcedError;forcedError=GL_NO_ERROR;}return e;}
 void glGetIntegerv(GLenum k,GLint* v){::glGetIntegerv(k,v);}
 void glGetBufferParameteriv(GLenum t,GLenum k,GLint* v){::glGetBufferParameteriv(t,k,v);}
} ops,*gGL=&ops;
struct Params {uint m_nOffset,m_nSize;};
