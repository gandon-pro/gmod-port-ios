// Executes the production RT projection with Source's exact ortho math and bucket loop.
#include <GLES3/gl3.h>
#include <EGL/egl.h>
#include <cassert>
#include <cmath>
#include <cstdio>
#include <vector>
#include <algorithm>
struct VMatrix {
 float m[4][4]{};
 float *operator[](int n){return m[n];}
 const float *operator[](int n)const{return m[n];}
 template<class...T>void Init(T...v){static_assert(sizeof...(v)==16);float values[]={float(v)...};for(int i=0;i<16;++i)m[i/4][i%4]=values[i];}
 void Identity(){for(int r=0;r<4;++r)for(int c=0;c<4;++c)m[r][c]=r==c?1.f:0.f;}
};
void MatrixMultiply(const VMatrix &a,const VMatrix &b,VMatrix &out){VMatrix tmp;for(int r=0;r<4;++r)for(int c=0;c<4;++c)for(int k=0;k<4;++k)tmp[r][c]+=a[r][k]*b[k][c];out=tmp;}
@SOURCE_ORTHO@
@SOURCE_SCALE@
@SOURCE_MATRIX_ORTHO@
enum {MATERIAL_PROJECTION,MATERIAL_VIEW,MATERIAL_MODEL};
struct Context {
 int mode=MATERIAL_MODEL;VMatrix matrices[3];std::vector<VMatrix> stack[3];
 Context(){for(auto &m:matrices)m.Identity();}
 void MatrixMode(int n){mode=n;}
 void PushMatrix(){stack[mode].push_back(matrices[mode]);}
 void PopMatrix(){assert(!stack[mode].empty());matrices[mode]=stack[mode].back();stack[mode].pop_back();}
 void LoadIdentity(){matrices[mode].Identity();}
 void Scale(float x,float y,float z){VMatrix scale;MatrixBuildScale(scale,x,y,z);MatrixMultiply(matrices[mode],scale,matrices[mode]);}
 void Ortho(double l,double t,double r,double b,double n,double f){MatrixOrtho(matrices[mode],l,t,r,b,n,f);}
};
using IMatRenderContext=Context;
@PRODUCTION_BEGIN_2D@
GLuint Compile(GLenum kind,const char *code){GLuint s=glCreateShader(kind);glShaderSource(s,1,&code,nullptr);glCompileShader(s);GLint okay;glGetShaderiv(s,GL_COMPILE_STATUS,&okay);if(!okay){char log[4096];glGetShaderInfoLog(s,sizeof(log),nullptr,log);std::fprintf(stderr,"%s\n",log);}assert(okay);return s;}
void Draw(GLuint program,const VMatrix &matrix){
 float columnMajor[16];for(int r=0;r<4;++r)for(int c=0;c<4;++c)columnMajor[c*4+r]=matrix[r][c];
 glClearColor(0,0,0,1);glClear(GL_COLOR_BUFFER_BIT);glUseProgram(program);glUniformMatrix4fv(glGetUniformLocation(program,"projection"),1,GL_FALSE,columnMajor);glDrawArrays(GL_TRIANGLES,0,6);
}
void Pixel(int x,int y,int r,int g,int b){unsigned char rgba[4];glReadPixels(x,y,1,1,GL_RGBA,GL_UNSIGNED_BYTE,rgba);assert(rgba[0]==r&&rgba[1]==g&&rgba[2]==b&&rgba[3]==255);}
void ProjectionTest(){
 EGLDisplay d=eglGetPlatformDisplay(0x31DD,EGL_DEFAULT_DISPLAY,nullptr);assert(d!=EGL_NO_DISPLAY&&eglInitialize(d,nullptr,nullptr));assert(eglBindAPI(EGL_OPENGL_ES_API));
 EGLint attr[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES3_BIT,EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_NONE};EGLConfig cfg;EGLint count;assert(eglChooseConfig(d,attr,&cfg,1,&count)&&count==1);
 EGLint size[]={EGL_WIDTH,256,EGL_HEIGHT,256,EGL_NONE},ca[]={EGL_CONTEXT_CLIENT_VERSION,3,EGL_NONE};
 EGLSurface surface=eglCreatePbufferSurface(d,cfg,size);EGLContext context=eglCreateContext(d,cfg,EGL_NO_CONTEXT,ca);assert(eglMakeCurrent(d,surface,surface,context));
 GLuint rt,fbo,vao;glGenTextures(1,&rt);glBindTexture(GL_TEXTURE_2D,rt);glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA8,256,256,0,GL_RGBA,GL_UNSIGNED_BYTE,nullptr);
 glGenFramebuffers(1,&fbo);glBindFramebuffer(GL_FRAMEBUFFER,fbo);glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,rt,0);assert(glCheckFramebufferStatus(GL_FRAMEBUFFER)==GL_FRAMEBUFFER_COMPLETE);
 glGenVertexArrays(1,&vao);glBindVertexArray(vao);glViewport(0,0,256,256);glDisable(GL_DITHER);glEnable(GL_CULL_FACE);glCullFace(GL_BACK);glFrontFace(GL_CW);
 const char *vs="#version 300 es\nuniform mat4 projection;out float y;void main(){vec2 p[6]=vec2[6](vec2(0,0),vec2(256,0),vec2(256,256),vec2(0,0),vec2(256,256),vec2(0,256));vec2 v=p[gl_VertexID];y=v.y;gl_Position=projection*vec4(v,0,1);}";
 const char *fs="#version 300 es\nprecision highp float;in float y;out vec4 color;void main(){color=y<128.?vec4(1,0,0,1):vec4(0,0,1,1);}";
 GLuint v=Compile(GL_VERTEX_SHADER,vs),f=Compile(GL_FRAGMENT_SHADER,fs),program=glCreateProgram();glAttachShader(program,v);glAttachShader(program,f);glLinkProgram(program);GLint okay;glGetProgramiv(program,GL_LINK_STATUS,&okay);assert(okay);
 Context old;old.MatrixMode(MATERIAL_PROJECTION);old.Ortho(0,0,256,256,-1,1);Draw(program,old.matrices[MATERIAL_PROJECTION]);Pixel(128,64,0,0,0);Pixel(128,192,0,0,0);
 glDisable(GL_CULL_FACE);Draw(program,old.matrices[MATERIAL_PROJECTION]);Pixel(128,192,0,0,255);Pixel(128,64,255,0,0);glEnable(GL_CULL_FACE);
 Context fixed;GMP_ToolScreenBegin2D(&fixed);assert(fixed.stack[MATERIAL_PROJECTION].size()==1&&fixed.stack[MATERIAL_VIEW].size()==1);
 Draw(program,fixed.matrices[MATERIAL_PROJECTION]);Pixel(128,192,255,0,0);Pixel(128,64,0,0,255);assert(glGetError()==GL_NO_ERROR);
 fixed.MatrixMode(MATERIAL_VIEW);fixed.PopMatrix();fixed.MatrixMode(MATERIAL_PROJECTION);fixed.PopMatrix();for(auto &stack:fixed.stack)assert(stack.empty());
 glDeleteProgram(program);glDeleteShader(v);glDeleteShader(f);glDeleteVertexArrays(1,&vao);glDeleteFramebuffers(1,&fbo);glDeleteTextures(1,&rt);
 eglMakeCurrent(d,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT);eglDestroyContext(d,context);eglDestroySurface(d,surface);eglTerminate(d);
 std::puts("PASS: Source ortho + production tool RT projection; old winding black with culling / reversed without culling; fixed red top and blue bottom on GLES3");
}
struct Color {};
struct C_BaseCombatWeapon {int slot,pos;int GetSlot()const{return slot;}};
struct Cvar {bool value=true;bool GetBool()const{return value;}} hud_showemptyweaponslots;
const int MAX_WEAPON_SLOTS=6,HUDTYPE_BUCKETS=0;
struct Selector {
 C_BaseCombatWeapon physgun{0,0},crowbar{0,5},toolgun{5,6};
 int m_flSmallBoxSize=32,m_flBoxGap=4,m_flAlphaOverride=255;
 Color m_BoxColor,m_EmptyBoxColor;int empty=0,real=0;
 int GetWide(){return 1200;}
 C_BaseCombatWeapon *GetWeaponInSlot(int slot,int pos){for(auto *w:{&physgun,&crowbar,&toolgun})if(w->slot==slot&&w->pos==pos)return w;return nullptr;}
 int GetLastPosInSlot(int slot){int last=-1;for(auto *w:{&physgun,&crowbar,&toolgun})if(w->slot==slot)last=std::max(last,w->pos);return last;}
 C_BaseCombatWeapon *GetFirstPos(int slot){for(int p=0;p<10;++p)if(auto *w=GetWeaponInSlot(slot,p))return w;return nullptr;}
 float GetWeaponBoxAlpha(bool){return 255;}
 void DrawBox(int,int,int,int h,Color,float,int){if(h==100)++empty;}
 void DrawLargeWeaponBox(C_BaseCombatWeapon *w,bool,int,int,int,int,Color,float,int){assert(w);++real;}
 void Paint(C_BaseCombatWeapon *pSelectedWeapon){int width,xpos,ypos;const int largeBoxWide=160,largeBoxTall=100;Color selectedColor;switch(HUDTYPE_BUCKETS){
 @SOURCE_BUCKET_CASE@
 }}
};
int main(){ProjectionTest();for(bool show:{true,false}){hud_showemptyweaponslots.value=show;Selector s;s.Paint(&s.toolgun);assert(s.real==1&&s.empty==(show?6:0));s.empty=s.real=0;s.Paint(&s.physgun);assert(s.real==2&&s.empty==(show?4:0));}std::puts("PASS: actual Source bucket loop; Tool Gun pos6 and crowbar pos5 gaps reproduced and removed, real weapons retained");}
