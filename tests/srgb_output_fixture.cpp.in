// Executes the exact generated output suffix and draw-state update from patch_engine.py.
#include <GLES3/gl3.h>
#include <EGL/egl.h>
#include <cassert>
#include <cmath>
#include <cstdio>
#include <string>
#define Msg(...) std::printf(__VA_ARGS__)
struct Ops {int updates=0;void glUniform1f(GLint location,float value){++updates;::glUniform1f(location,value);}} ops,*gGL=&ops;
struct Pair{GLint m_locFragmentFakeSRGBEnable=-1;float m_fakeSRGBEnableValue=-1;};
struct Context {
 struct {bool m_hasGammaWrites=false;} m_caps;
 bool m_FakeBlendEnableSRGB=false;Pair* m_pBoundPair=nullptr;
 void Flush(){
 @DRAW_STATE@
 }
};
bool NeedsSuffix(int outputs){
 int m_iFragDataCount=outputs;bool m_bGenerateSRGBWriteSuffix=true;
 @DEPTH_GUARD@
 return m_bGenerateSRGBWriteSuffix;
}
GLuint Compile(GLenum type,const char* code){GLuint s=glCreateShader(type);glShaderSource(s,1,&code,nullptr);glCompileShader(s);GLint okay;glGetShaderiv(s,GL_COMPILE_STATUS,&okay);if(!okay){char b[4096];glGetShaderInfoLog(s,sizeof(b),nullptr,b);std::fprintf(stderr,"%s\n",b);}assert(okay);return s;}
GLuint Program(){
 const char* vs="#version 300 es\nvoid main(){vec2 p=vec2(float((gl_VertexID<<1)&2),float(gl_VertexID&2));gl_Position=vec4(p*2.-1.,0,1);}";
 const char* fs=R"GLSL(#version 300 es
 precision highp float;
 uniform float flSRGBWrite;
 uniform vec4 inputColor;
 out vec4 outputs[1];
 #define gl_FragData outputs
 void main(){gl_FragData[0]=inputColor;
 @SUFFIX@
 }
 )GLSL";
 GLuint v=Compile(GL_VERTEX_SHADER,vs),f=Compile(GL_FRAGMENT_SHADER,fs),program=glCreateProgram();glAttachShader(program,v);glAttachShader(program,f);glLinkProgram(program);
 GLint okay;glGetProgramiv(program,GL_LINK_STATUS,&okay);assert(okay);glDeleteShader(v);glDeleteShader(f);return program;
}
void Draw(GLuint program,float x,bool encoded,Context& ctx){
 glUseProgram(program);ctx.Flush();glUniform4f(glGetUniformLocation(program,"inputColor"),x,x,x,0.25f);glDrawArrays(GL_TRIANGLES,0,3);
 unsigned char pixel[4];glReadPixels(0,0,1,1,GL_RGBA,GL_UNSIGNED_BYTE,pixel);
 float out=x;if(encoded){out=std::fmax(x,0.0f);out=out<=0.0031308f?12.92f*out:1.055f*std::pow(out,1.0f/2.4f)-0.055f;}
 int expected=int(std::lround(std::fmin(1.f,std::fmax(0.f,out))*255));
 for(int c=0;c<3;++c){if(std::abs(int(pixel[c])-expected)>1){std::fprintf(stderr,"linear=%g encode=%d actual=%d expected=%d\n",x,encoded,pixel[c],expected);assert(false);}}
 assert(std::abs(int(pixel[3])-64)<=1);assert(glGetError()==GL_NO_ERROR);
}
int main(){
 EGLDisplay d=eglGetPlatformDisplay(0x31DD,EGL_DEFAULT_DISPLAY,nullptr);assert(d!=EGL_NO_DISPLAY&&eglInitialize(d,nullptr,nullptr));assert(eglBindAPI(EGL_OPENGL_ES_API));
 EGLint attrs[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES3_BIT,EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_NONE};
 EGLConfig cfg;EGLint n;assert(eglChooseConfig(d,attrs,&cfg,1,&n)&&n==1);EGLint size[]={EGL_WIDTH,1,EGL_HEIGHT,1,EGL_NONE},ca[]={EGL_CONTEXT_CLIENT_VERSION,3,EGL_NONE};
 EGLSurface surface=eglCreatePbufferSurface(d,cfg,size);EGLContext context=eglCreateContext(d,cfg,EGL_NO_CONTEXT,ca);assert(eglMakeCurrent(d,surface,surface,context));
 GLuint vao;glGenVertexArrays(1,&vao);glBindVertexArray(vao);glViewport(0,0,1,1);glDisable(GL_DITHER);
 assert(!NeedsSuffix(0)&&NeedsSuffix(1));
 GLuint depthShader=Compile(GL_FRAGMENT_SHADER,"#version 300 es\nprecision highp float;void main(){gl_FragDepth=0.5;}");glDeleteShader(depthShader);
 GLuint first=Program(),second=Program();Pair a,b;a.m_locFragmentFakeSRGBEnable=glGetUniformLocation(first,"flSRGBWrite");b.m_locFragmentFakeSRGBEnable=glGetUniformLocation(second,"flSRGBWrite");
 assert(a.m_locFragmentFakeSRGBEnable==0); // Exercise the valid zero-location case on Mesa.
 Context ctx;ctx.m_pBoundPair=&a;
 Draw(first,0.18f,false,ctx);int previous=ops.updates;
 ctx.m_FakeBlendEnableSRGB=true;
 for(float v:{-0.5f,0.f,0.001f,0.0031308f,0.18f,0.5f,1.f})Draw(first,v,true,ctx);
 assert(ops.updates==previous+1); // Uniform state is cached, not uploaded every draw.
 ctx.m_FakeBlendEnableSRGB=false;Draw(first,0.5f,false,ctx);
 ctx.m_pBoundPair=&b;ctx.m_FakeBlendEnableSRGB=true;Draw(second,0.18f,true,ctx);
 ctx.m_pBoundPair=&a;Draw(first,0.18f,true,ctx);
 // Linear intermediates and gamma-space UI pass through without another conversion.
 ctx.m_FakeBlendEnableSRGB=false;Draw(first,0.502f,false,ctx);Draw(first,1.f,false,ctx);
 Pair missing;ctx.m_pBoundPair=&missing;previous=ops.updates;ctx.Flush();assert(ops.updates==previous);assert(glGetError()==GL_NO_ERROR);
 // Reproduce Source's render-target -> linear presentation blit.
 ctx.m_pBoundPair=&a;
 auto roundTrip=[&](GLint storage,bool encode){
  GLuint texture,fbo;glGenTextures(1,&texture);glBindTexture(GL_TEXTURE_2D,texture);
  glTexImage2D(GL_TEXTURE_2D,0,storage,1,1,0,GL_RGBA,GL_UNSIGNED_BYTE,nullptr);
  glGenFramebuffers(1,&fbo);glBindFramebuffer(GL_FRAMEBUFFER,fbo);
  glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,texture,0);
  assert(glCheckFramebufferStatus(GL_FRAMEBUFFER)==GL_FRAMEBUFFER_COMPLETE);
  ctx.m_FakeBlendEnableSRGB=encode;glUseProgram(first);ctx.Flush();
  glUniform4f(glGetUniformLocation(first,"inputColor"),0.18f,0.18f,0.18f,0.25f);glDrawArrays(GL_TRIANGLES,0,3);
  glBindFramebuffer(GL_READ_FRAMEBUFFER,fbo);glBindFramebuffer(GL_DRAW_FRAMEBUFFER,0);
  glBlitFramebuffer(0,0,1,1,0,0,1,1,GL_COLOR_BUFFER_BIT,GL_NEAREST);
  glBindFramebuffer(GL_READ_FRAMEBUFFER,0);unsigned char pixel[4];glReadPixels(0,0,1,1,GL_RGBA,GL_UNSIGNED_BYTE,pixel);
  glDeleteFramebuffers(1,&fbo);glDeleteTextures(1,&texture);glBindFramebuffer(GL_FRAMEBUFFER,0);
  assert(glGetError()==GL_NO_ERROR);return int(pixel[0]);
 };
 int oldRoute=roundTrip(GL_SRGB8_ALPHA8,false),newRoute=roundTrip(GL_RGBA8,true);
 assert(std::abs(oldRoute-46)<=1);assert(std::abs(newRoute-118)<=1);
 std::printf("Actual RT/presentation blit: old route=%d, software sRGB + linear storage=%d\n",oldRoute,newRoute);
 glDeleteProgram(first);glDeleteProgram(second);glDeleteVertexArrays(1,&vao);
 eglMakeCurrent(d,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT);eglDestroyContext(d,context);eglDestroySurface(d,surface);eglTerminate(d);
 std::puts("Source sRGB output: linear 0.18 -> encoded 118/255 vs unencoded 46/255; thresholds, alpha, state toggles, program switches, raw/UI passthrough passed");
}
